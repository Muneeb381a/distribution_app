generator client {
  provider      = "prisma-client-js"
  // Vercel runs functions on Amazon Linux; the engine for it is downloaded too.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BusinessLineCode {
  BOTTLES
  RICE
}

enum LocationType {
  GODOWN
  SHOP
  VEHICLE
}

enum CustomerType {
  CASH
  CREDIT
}

enum SupplierType {
  BEVERAGE
  RICE_MILL
  OTHER
}

enum EmployeeType {
  MONTHLY
  DAILY
}

enum BaseUnit {
  BOTTLE
  KG
}

enum UnitName {
  BOTTLE
  CARTON
  KG
  MAUND
  BAG
}

// ---------- system ----------

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  permissions RolePermission[]
  users       AppUser[]
}

model RolePermission {
  roleId         String
  permissionCode String
  role           Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionCode])
}

model AppUser {
  id           String     @id @default(uuid())
  username     String     @unique
  passwordHash String
  roleId       String
  employeeId   String?    @unique
  isActive     Boolean    @default(true)
  displayName  String?
  avatar       String?
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id])
  employee     Employee?  @relation(fields: [employeeId], references: [id])
  auditLogs    AuditLog[]
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entity     String
  entityId   String?
  beforeJson Json?
  afterJson  Json?
  at         DateTime @default(now())
  user       AppUser? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([at])
}

// ---------- master data ----------

model BusinessLine {
  id         String           @id @default(uuid())
  code       BusinessLineCode @unique
  name       String
  categories Category[]
}

model Category {
  id             String       @id @default(uuid())
  businessLineId String
  name           String
  parentId       String?
  businessLine   BusinessLine @relation(fields: [businessLineId], references: [id])
  parent         Category?    @relation("CategoryTree", fields: [parentId], references: [id])
  children       Category[]   @relation("CategoryTree")
  products       Product[]

  @@unique([businessLineId, parentId, name])
}

model Product {
  id                  String                  @id @default(uuid())
  categoryId          String
  name                String
  brand               String?
  size                String?
  baseUnit            BaseUnit
  isPacked            Boolean                 @default(false)
  returnableEmpty     Boolean                 @default(false)
  isActive            Boolean                 @default(true)
  /// Order more when saleable stock in all locations together falls to this (base units). Null = not watched.
  reorderLevel        Decimal?                @db.Decimal(14, 3)
  createdAt           DateTime                @default(now())
  category            Category                @relation(fields: [categoryId], references: [id])
  units               ProductUnit[]
  customerRates       CustomerRate[]
  stockMovements      StockMovement[]
  cost                ProductCost?
  purchaseItems       PurchaseItem[]
  purchaseReturnItems PurchaseReturnItem[]
  stockTransferItems  StockTransferItem[]
  prices              ProductPrice[]
  saleItems           SaleItem[]
  saleReturnItems     SaleReturnItem[]
  emptiesLedger       EmptiesLedger[]
  tripLines           VehicleTripLine[]
  supplierEmpties     SupplierEmptiesLedger[]

  @@index([categoryId])
}

model ProductUnit {
  productId    String
  unitName     UnitName
  factorToBase Decimal  @db.Decimal(14, 3)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, unitName])
}

model Location {
  id              String           @id @default(uuid())
  name            String           @unique
  type            LocationType
  isActive        Boolean          @default(true)
  /**
   * Vehicles only: number plate, kind (pickup, loader rickshaw...), usual driver and a free note.
   */
  regNo           String?
  vehicleKind     String?
  driverId        String?
  driver          Employee?        @relation("VehicleDriver", fields: [driverId], references: [id], onDelete: SetNull)
  note            String?
  movements       StockMovement[]
  purchases       Purchase[]
  purchaseReturns PurchaseReturn[]
  transfersFrom   StockTransfer[]  @relation("TransferFrom")
  transfersTo     StockTransfer[]  @relation("TransferTo")
  sales           Sale[]
  expenses        Expense[]
  trips           VehicleTrip[]
}

model Employee {
  id                String          @id @default(uuid())
  drivenVehicles    Location[]      @relation("VehicleDriver")
  name              String
  phone             String?
  type              EmployeeType
  monthlySalary     Decimal?        @db.Decimal(14, 2)
  dailyWage         Decimal?        @db.Decimal(14, 2)
  joinDate          DateTime?       @db.Date
  isActive          Boolean         @default(true)
  user              AppUser?
  sales             Sale[]
  /// Percent of the employee's delivered net sales paid as commission (e.g. 1.5). Null = none.
  commissionPercent Decimal?        @db.Decimal(5, 2)
  /// The day of the week this person is off (0 = Sunday .. 6 = Saturday); null = no fixed day off.
  weeklyOff         Int?
  attendance        Attendance[]
  advances          SalaryAdvance[]
  payrollRuns       PayrollRun[]
  trips             VehicleTrip[]
}

model Customer {
  id             String           @id @default(uuid())
  name           String
  shopName       String?
  phone          String?
  address        String?
  area           String?
  type           CustomerType     @default(CASH)
  creditLimit    Decimal?         @db.Decimal(14, 2)
  openingBalance Decimal          @default(0) @db.Decimal(14, 2)
  /// Which list rates this customer pays: RETAIL or WHOLESALE.
  priceTier      String           @default("RETAIL")
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  rates          CustomerRate[]
  sales          Sale[]
  ledger         CustomerLedger[]
  payments       Payment[]
  reminders      ReminderLog[]
  empties        EmptiesLedger[]

  @@index([name])
  @@index([area])
}

model CustomerRate {
  customerId String
  productId  String
  unitName   UnitName
  rate       Decimal  @db.Decimal(14, 2)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])

  @@id([customerId, productId, unitName])
}

model Supplier {
  id               String                  @id @default(uuid())
  name             String
  phone            String?
  type             SupplierType            @default(OTHER)
  openingBalance   Decimal                 @default(0) @db.Decimal(14, 2)
  isActive         Boolean                 @default(true)
  purchases        Purchase[]
  purchaseReturns  PurchaseReturn[]
  supplierPayments SupplierPayment[]
  supplierLedgers  SupplierLedger[]
  empties          SupplierEmptiesLedger[]
}

// ---------- Phase 2: stock, purchasing, supplier ledger ----------

enum StockStatus {
  OK
  DAMAGED
}

enum MovementType {
  OPENING
  PURCHASE
  PURCHASE_CANCEL
  PURCHASE_RETURN
  SALE
  SALE_RETURN
  SALE_CANCEL
  TRANSFER_OUT
  TRANSFER_IN
  ADJUST
  DAMAGE_MARK
  DAMAGE_RESTORE
  WRITE_OFF
}

enum LedgerRefType {
  PURCHASE
  PAYMENT
  RETURN
  CANCEL
}

enum DocStatus {
  ACTIVE
  CANCELLED
}

/// Document numbers for server-created documents (P-000001, T-000001, ...).
model Counter {
  key   String @id
  value Int
}

/// Append-only. qtyBase is signed: positive adds stock, negative removes it.
model StockMovement {
  id          String       @id @default(uuid())
  productId   String
  locationId  String
  qtyBase     Decimal      @db.Decimal(14, 3)
  status      StockStatus  @default(OK)
  type        MovementType
  refType     String?
  refId       String?
  note        String?
  createdById String
  createdAt   DateTime     @default(now())
  product     Product      @relation(fields: [productId], references: [id])
  location    Location     @relation(fields: [locationId], references: [id])

  @@index([productId, locationId, status])
  @@index([refType, refId])
  @@index([createdAt])
}

model ProductCost {
  productId          String   @id
  latestUnitCostBase Decimal  @db.Decimal(14, 4)
  updatedAt          DateTime @updatedAt
  product            Product  @relation(fields: [productId], references: [id])
}

model Purchase {
  id          String         @id @default(uuid())
  purchaseNo  String         @unique
  supplierId  String
  locationId  String
  date        DateTime       @db.Date
  total       Decimal        @db.Decimal(14, 2)
  paidNow     Decimal        @default(0) @db.Decimal(14, 2)
  note        String?
  status      DocStatus      @default(ACTIVE)
  createdById String
  createdAt   DateTime       @default(now())
  supplier    Supplier       @relation(fields: [supplierId], references: [id])
  location    Location       @relation(fields: [locationId], references: [id])
  items       PurchaseItem[]

  @@index([supplierId, date])
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String
  productId  String
  unitName   UnitName
  qty        Decimal  @db.Decimal(14, 3)
  qtyBase    Decimal  @db.Decimal(14, 3)
  unitPrice  Decimal  @db.Decimal(14, 2)
  lineTotal  Decimal  @db.Decimal(14, 2)
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])
}

model PurchaseReturn {
  id          String               @id @default(uuid())
  returnNo    String               @unique
  supplierId  String
  locationId  String
  date        DateTime             @db.Date
  total       Decimal              @db.Decimal(14, 2)
  note        String?
  createdById String
  createdAt   DateTime             @default(now())
  supplier    Supplier             @relation(fields: [supplierId], references: [id])
  location    Location             @relation(fields: [locationId], references: [id])
  items       PurchaseReturnItem[]
}

model PurchaseReturnItem {
  id         String         @id @default(uuid())
  returnId   String
  productId  String
  unitName   UnitName
  qty        Decimal        @db.Decimal(14, 3)
  qtyBase    Decimal        @db.Decimal(14, 3)
  unitPrice  Decimal        @db.Decimal(14, 2)
  lineTotal  Decimal        @db.Decimal(14, 2)
  fromStatus StockStatus
  ret        PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product    Product        @relation(fields: [productId], references: [id])
}

model SupplierPayment {
  id          String    @id @default(uuid())
  paymentNo   String    @unique
  supplierId  String
  amount      Decimal   @db.Decimal(14, 2)
  method      String    @default("CASH")
  date        DateTime  @db.Date
  note        String?
  createdById String
  createdAt   DateTime  @default(now())
  chequeNo    String?
  chequeBank  String?
  chequeDate  DateTime? @db.Date
  supplier    Supplier  @relation(fields: [supplierId], references: [id])
}

/// amount > 0 means we owe the supplier more (purchase); amount < 0 means we owe less (payment, return).
/// Balance = Supplier.openingBalance + sum(amount).
model SupplierLedger {
  id          String        @id @default(uuid())
  supplierId  String
  date        DateTime      @db.Date
  amount      Decimal       @db.Decimal(14, 2)
  refType     LedgerRefType
  refId       String
  note        String?
  createdById String
  createdAt   DateTime      @default(now())
  supplier    Supplier      @relation(fields: [supplierId], references: [id])

  @@index([supplierId, date])
}

model StockTransfer {
  id             String              @id @default(uuid())
  transferNo     String              @unique
  fromLocationId String
  toLocationId   String
  date           DateTime            @db.Date
  note           String?
  createdById    String
  createdAt      DateTime            @default(now())
  from           Location            @relation("TransferFrom", fields: [fromLocationId], references: [id])
  to             Location            @relation("TransferTo", fields: [toLocationId], references: [id])
  items          StockTransferItem[]
}

model StockTransferItem {
  id         String        @id @default(uuid())
  transferId String
  productId  String
  unitName   UnitName
  qty        Decimal       @db.Decimal(14, 3)
  qtyBase    Decimal       @db.Decimal(14, 3)
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product    Product       @relation(fields: [productId], references: [id])
}

// ---------- Phase 3: sales, customer khata, payments, empties ----------

enum SaleType {
  COUNTER
  DELIVERY
}

enum ReturnReason {
  DAMAGED
  EXPIRED
}

enum CustomerLedgerRef {
  SALE
  PAYMENT
  SALE_CANCEL
  PAYMENT_CANCEL
  CHEQUE_BOUNCED
}

/// List price used when the customer has no fixed rate.
/// List rate per unit and price list (RETAIL or WHOLESALE); used when the customer has no fixed rate.
model ProductPrice {
  productId String
  unitName  UnitName
  tier      String   @default("RETAIL")
  rate      Decimal  @db.Decimal(14, 2)
  product   Product  @relation(fields: [productId], references: [id])

  @@id([productId, unitName, tier])
}

model Sale {
  id              String           @id @default(uuid())
  billNo          String           @unique
  /// Client-generated id so a bill that is sent twice is only created once.
  clientId        String?          @unique
  businessLine    BusinessLineCode
  saleType        SaleType
  customerId      String?
  locationId      String
  salesmanId      String?
  date            DateTime         @db.Date
  gross           Decimal          @db.Decimal(14, 2)
  returnsCredit   Decimal          @default(0) @db.Decimal(14, 2)
  net             Decimal          @db.Decimal(14, 2)
  paidNow         Decimal          @default(0) @db.Decimal(14, 2)
  /// Customer balance before and after this bill, frozen so reprints match what the customer saw.
  previousBalance Decimal          @default(0) @db.Decimal(14, 2)
  newBalance      Decimal          @default(0) @db.Decimal(14, 2)
  note            String?
  /// Empties given/collected/held-after per product, frozen at billing time.
  empties         Json?
  status          DocStatus        @default(ACTIVE)
  createdById     String
  createdAt       DateTime         @default(now())
  cancelledById   String?
  cancelledAt     DateTime?
  /// The vehicle that carries a delivery. Equals the location for a bill from a loaded vehicle; for a bill from the godown it is just the carrier.
  vehicleId       String?
  /// PENDING until the goods reach the customer, then DELIVERED. Only dispatches from a godown/shop are tracked.
  deliveryStatus  String?
  deliveredAt     DateTime?
  deliveredById   String?
  /// Who took the goods at the customer's end (the name on the signed slip).
  receivedBy      String?
  customer        Customer?        @relation(fields: [customerId], references: [id])
  location        Location         @relation(fields: [locationId], references: [id])
  salesman        Employee?        @relation(fields: [salesmanId], references: [id])
  items           SaleItem[]
  returns         SaleReturnItem[]
  payments        Payment[]
  proofs          SaleProof[]

  @@index([customerId, date])
  @@index([businessLine, date])
  @@index([salesmanId, date])
  @@index([deliveryStatus])
  @@index([vehicleId, createdAt])
}

model SaleItem {
  id           String   @id @default(uuid())
  saleId       String
  productId    String
  unitName     UnitName
  qty          Decimal  @db.Decimal(14, 3)
  qtyBase      Decimal  @db.Decimal(14, 3)
  rate         Decimal  @db.Decimal(14, 2)
  lineTotal    Decimal  @db.Decimal(14, 2)
  /// Latest purchase cost per base unit at the moment of sale; frozen so past profit never changes.
  unitCostBase Decimal? @db.Decimal(14, 4)
  sale         Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id])
}

model SaleReturnItem {
  id           String       @id @default(uuid())
  saleId       String
  productId    String
  unitName     UnitName
  qty          Decimal      @db.Decimal(14, 3)
  qtyBase      Decimal      @db.Decimal(14, 3)
  rate         Decimal      @db.Decimal(14, 2)
  creditAmount Decimal      @db.Decimal(14, 2)
  reason       ReturnReason
  sale         Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])
}

/// amount > 0 means the customer owes more (bill); amount < 0 means they owe less (payment).
/// Balance = Customer.openingBalance + sum(amount).
model CustomerLedger {
  id          String            @id @default(uuid())
  customerId  String
  date        DateTime          @db.Date
  amount      Decimal           @db.Decimal(14, 2)
  refType     CustomerLedgerRef
  refId       String
  note        String?
  createdById String
  createdAt   DateTime          @default(now())
  customer    Customer          @relation(fields: [customerId], references: [id])

  @@index([customerId, date])
}

/// A receipt: money received from a customer, either with a bill or on its own.
model Payment {
  id              String    @id @default(uuid())
  receiptNo       String    @unique
  clientId        String?   @unique
  customerId      String
  saleId          String?
  amount          Decimal   @db.Decimal(14, 2)
  method          String    @default("CASH")
  date            DateTime  @db.Date
  previousBalance Decimal   @db.Decimal(14, 2)
  newBalance      Decimal   @db.Decimal(14, 2)
  note            String?
  status          DocStatus @default(ACTIVE)
  createdById     String
  createdAt       DateTime  @default(now())
  /// Cheque details when method = CHEQUE. The khata is credited on receipt; a bounce puts it back.
  chequeNo        String?
  chequeBank      String?
  /// Date written on the cheque (often post-dated): when it can be deposited.
  chequeDate      DateTime? @db.Date
  /// PENDING until deposited and cleared, then CLEARED or BOUNCED.
  chequeStatus    String?
  chequeSettledAt DateTime?
  customer        Customer  @relation(fields: [customerId], references: [id])
  sale            Sale?     @relation(fields: [saleId], references: [id])

  @@index([customerId, date])
  @@index([createdById, date])
  @@index([chequeStatus, chequeDate])
}

/// Returnable empties (counted in bottles). Cancelling a bill adds an offsetting row.
model EmptiesLedger {
  id          String   @id @default(uuid())
  customerId  String
  productId   String
  qtyOut      Int      @default(0)
  qtyIn       Int      @default(0)
  saleId      String?
  createdById String
  createdAt   DateTime @default(now())
  customer    Customer @relation(fields: [customerId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])

  @@index([customerId, productId])
}

// ---------- Phase 5: expenses, attendance, advances, payroll ----------

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  PAID_LEAVE
  UNPAID_LEAVE
}

/// businessLine null means a shared cost (rent, bills) that belongs to both lines.
/// The expense categories the owner manages. Expenses keep the category name as text, so history never breaks.
model ExpenseCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  /// Hex colour such as #0ea5e9; null = a colour is worked out from the name.
  color     String?
  /// Made by the system (payroll posts to "Salaries"): cannot be renamed or hidden.
  isSystem  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Expense {
  id           String            @id @default(uuid())
  date         DateTime          @db.Date
  category     String
  /// Old entries only: expenses are no longer split by business line; they come off total profit.
  businessLine BusinessLineCode?
  /// Godown or shop the cost belongs to; null = general (salaries, office).
  locationId   String?
  location     Location?         @relation(fields: [locationId], references: [id])
  amount       Decimal           @db.Decimal(14, 2)
  note         String?
  /// Set for expenses created by the system (e.g. PAYROLL) so they can't be edited by hand.
  source       String?
  sourceId     String?
  status       DocStatus         @default(ACTIVE)
  createdById  String
  createdAt    DateTime          @default(now())

  @@index([date])
  @@index([locationId])
}

/// A day off for the business (Eid, 14 August) or for chosen employees. Monthly staff are not cut for it;
/// daily-wage staff are not paid for it unless they worked.
model Holiday {
  id          String   @id @default(uuid())
  date        DateTime @unique @db.Date
  name        String
  /// Empty = everyone; otherwise only these employees.
  employeeIds String[]
  createdById String
  createdAt   DateTime @default(now())
}

/// Each time someone reminded a customer about an unpaid balance (opened the WhatsApp message or called).
model ReminderLog {
  id          String   @id @default(uuid())
  customerId  String
  channel     String
  /// What they owed when reminded.
  amount      Decimal  @db.Decimal(14, 2)
  createdById String
  at          DateTime @default(now())
  customer    Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, at])
}

/// The end-of-day cash count: what the drawer should hold, what was counted, and the difference.
model DayClose {
  id          String   @id @default(uuid())
  date        DateTime @unique @db.Date
  /// Cash in the drawer when the day started (the previous day's count unless entered).
  openingCash Decimal  @db.Decimal(14, 2)
  cashIn      Decimal  @db.Decimal(14, 2)
  cashOut     Decimal  @db.Decimal(14, 2)
  expected    Decimal  @db.Decimal(14, 2)
  counted     Decimal  @db.Decimal(14, 2)
  /// counted - expected: negative = short, positive = over.
  difference  Decimal  @db.Decimal(14, 2)
  note        String?
  /// Sales, udhaar and money by method as they stood when the day was closed.
  summary     Json?
  closedById  String
  closedAt    DateTime @default(now())
}

/// A photo kept with a bill, normally of the signed delivery slip as proof the goods arrived.
model SaleProof {
  id          String   @id @default(uuid())
  saleId      String
  mime        String
  data        Bytes
  bytes       Int
  createdById String
  createdAt   DateTime @default(now())
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

model Attendance {
  employeeId String
  date       DateTime         @db.Date
  status     AttendanceStatus
  employee   Employee         @relation(fields: [employeeId], references: [id])

  @@id([employeeId, date])
}

/// Money given to an employee ahead of salary. It is recovered from salary (all at once, or a fixed
/// instalment each month) and/or repaid in cash; what is left is amount − active recoveries.
model SalaryAdvance {
  id          String            @id @default(uuid())
  employeeId  String
  date        DateTime          @db.Date
  amount      Decimal           @db.Decimal(14, 2)
  /// Cut from each salary until recovered. Null = recover the whole remainder from the next salary.
  installment Decimal?          @db.Decimal(14, 2)
  note        String?
  status      DocStatus         @default(ACTIVE)
  createdById String
  createdAt   DateTime          @default(now())
  employee    Employee          @relation(fields: [employeeId], references: [id])
  recoveries  AdvanceRecovery[]

  @@index([employeeId, date])
}

/// One repayment of an advance: a cut from a payroll run, or cash handed back. Cancelling the run cancels its cuts.
model AdvanceRecovery {
  id           String        @id @default(uuid())
  advanceId    String
  /// The payroll run that deducted it; null for a cash repayment.
  payrollRunId String?
  date         DateTime      @db.Date
  amount       Decimal       @db.Decimal(14, 2)
  note         String?
  status       DocStatus     @default(ACTIVE)
  createdById  String
  createdAt    DateTime      @default(now())
  advance      SalaryAdvance @relation(fields: [advanceId], references: [id])
  payrollRun   PayrollRun?   @relation(fields: [payrollRunId], references: [id])

  @@index([advanceId])
  @@index([payrollRunId])
}

/// One finalised salary calculation for an employee and month ("2026-11").
model PayrollRun {
  id               String            @id @default(uuid())
  employeeId       String
  month            String
  base             Decimal           @db.Decimal(14, 2)
  commission       Decimal           @default(0) @db.Decimal(14, 2)
  absenceDeduction Decimal           @default(0) @db.Decimal(14, 2)
  gross            Decimal           @db.Decimal(14, 2)
  advances         Decimal           @default(0) @db.Decimal(14, 2)
  carryIn          Decimal           @default(0) @db.Decimal(14, 2)
  /// Cash paid to the employee (never negative).
  netPaid          Decimal           @db.Decimal(14, 2)
  /// Advances beyond what was earned; deducted from next month.
  carryOut         Decimal           @default(0) @db.Decimal(14, 2)
  details          Json?
  paidOn           DateTime          @db.Date
  createdById      String
  createdAt        DateTime          @default(now())
  status           DocStatus         @default(ACTIVE)
  cancelledById    String?
  cancelledAt      DateTime?
  cancelReason     String?
  employee         Employee          @relation(fields: [employeeId], references: [id])
  recoveries       AdvanceRecovery[]

  /// One ACTIVE run per employee and month is enforced by a partial unique index (see the cancel_payroll migration).
  @@index([employeeId, month])
}

/// Empties (bottles / crates) we received from or sent back to a supplier. Held by us = qtyIn - qtyOut over ACTIVE rows.
model SupplierEmptiesLedger {
  id            String    @id @default(uuid())
  supplierId    String
  productId     String
  date          DateTime  @db.Date
  /// Received from the supplier (we owe these back).
  qtyIn         Int       @default(0)
  /// Returned to the supplier.
  qtyOut        Int       @default(0)
  note          String?
  status        DocStatus @default(ACTIVE)
  createdById   String
  createdAt     DateTime  @default(now())
  cancelledById String?
  cancelledAt   DateTime?
  supplier      Supplier  @relation(fields: [supplierId], references: [id])
  product       Product   @relation(fields: [productId], references: [id])

  @@index([supplierId, productId])
}

/// App-wide settings as JSON under a key ("business": name, address, phone, bill footer, thermal width).
model Setting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?
}

/**
 * One day's round of a vehicle: loaded from the godown in the morning, sells on the route, and is
 * settled in the evening (stock counted, cash handed over, the rest unloaded).
 */
model VehicleTrip {
  id           String            @id @default(uuid())
  tripNo       String            @unique
  vehicleId    String
  salesmanId   String?
  date         DateTime          @db.Date
  /// OPEN while on the road; SETTLED once counted and cash is in.
  status       String            @default("OPEN")
  openedAt     DateTime          @default(now())
  openedById   String
  settledAt    DateTime?
  settledById  String?
  /// Cash taken with bills on this trip (from the bills), and what the salesman handed over.
  cashExpected Decimal?          @db.Decimal(14, 2)
  cashReceived Decimal?          @db.Decimal(14, 2)
  note         String?
  /// Advance created for a cash shortage, recovered from the salesman's salary.
  advanceId    String?
  vehicle      Location          @relation(fields: [vehicleId], references: [id])
  salesman     Employee?         @relation(fields: [salesmanId], references: [id])
  lines        VehicleTripLine[]

  @@index([vehicleId, status])
  @@index([date])
}

/// Per product at settlement: what the stock should be on the vehicle and what was counted.
model VehicleTripLine {
  id        String      @id @default(uuid())
  tripId    String
  productId String
  loaded    Decimal     @db.Decimal(14, 3)
  sold      Decimal     @db.Decimal(14, 3)
  expected  Decimal     @db.Decimal(14, 3)
  counted   Decimal     @db.Decimal(14, 3)
  /// counted - expected: negative is a shortage, positive is extra.
  diff      Decimal     @db.Decimal(14, 3)
  unloaded  Decimal     @db.Decimal(14, 3)
  trip      VehicleTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  product   Product     @relation(fields: [productId], references: [id])

  @@unique([tripId, productId])
}

// ---------------------------------------------------------------------------------------------------------------
// Platform side: the businesses (tenants) that use the software, the people who run the platform, and what they do.
// These live in the main ("public") schema; every business keeps its own copy of everything above in its own schema.
// ---------------------------------------------------------------------------------------------------------------

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

model Tenant {
  id              String       @id @default(uuid())
  /// What staff type next to their username to sign in, e.g. "ali-traders".
  code            String       @unique
  name            String
  /// The database schema holding this business's data; "public" for the original business.
  schemaName      String       @unique
  isMain          Boolean      @default(false)
  contactName     String?
  phone           String?
  email           String?
  city            String?
  status          TenantStatus @default(TRIAL)
  /// After this day sign-in stops (null = never).
  expiresAt       DateTime?
  /// Most active staff accounts allowed (null = no limit).
  maxUsers        Int?
  notes           String?
  suspendedReason String?
  createdAt       DateTime     @default(now())
  lastActiveAt    DateTime?

  logins LoginEvent[]
  seen   TenantUserSeen[]
  usage  UsageDaily[]
}

model PlatformAdmin {
  id           String    @id @default(uuid())
  username     String    @unique
  passwordHash String
  displayName  String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
}

/// Every sign-in attempt, to a business or to the platform console, with where it came from.
model LoginEvent {
  id         String   @id @default(uuid())
  /// TENANT or PLATFORM
  scope      String
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// What was typed, kept even when it matched no business.
  tenantCode String?
  username   String
  success    Boolean
  reason     String?
  ip         String?
  userAgent  String?
  browser    String?
  os         String?
  device     String?
  country    String?
  region     String?
  city       String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([createdAt])
  @@index([ip, createdAt])
  @@index([scope, username, createdAt])
}

/// One row per person + device + address seen working in a business, so the console can list who uses it from where.
model TenantUserSeen {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  username    String
  /// Hash of address + browser, so the same device is one row.
  fingerprint String
  ip          String?
  userAgent   String?
  browser     String?
  os          String?
  device      String?
  country     String?
  region      String?
  city        String?
  firstSeen   DateTime @default(now())
  lastSeen    DateTime @default(now())
  hits        Int      @default(0)

  @@unique([tenantId, username, fingerprint])
  @@index([tenantId, lastSeen])
}

/// Requests per business per day, and which part of the app they went to.
model UsageDaily {
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  day      DateTime @db.Date
  requests Int      @default(0)
  writes   Int      @default(0)
  errors   Int      @default(0)
  /// { "sales": 40, "stock": 12 }: requests by first part of the path.
  modules  Json     @default("{}")

  @@id([tenantId, day])
}

/// What platform admins did in the console: who suspended whom, who reset which password.
model PlatformAudit {
  id         String   @id @default(uuid())
  adminId    String?
  adminName  String
  action     String
  tenantId   String?
  tenantName String?
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([tenantId, createdAt])
}
