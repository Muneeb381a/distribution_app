# Copy this file to deploy/.env and fill it in. Never commit deploy/.env.

# --- secrets: make long random ones, for example:  openssl rand -hex 24
# DB_PASSWORD: letters and digits only (it goes inside a connection address).
DB_PASSWORD=
JWT_SECRET=

# --- where people open the system (two names that both point at this server)
# With your own domain:
#   WEB_HOST=app.yourshop.pk          API_HOST=api.yourshop.pk
#   WEB_ORIGIN=https://app.yourshop.pk    PUBLIC_API_URL=https://api.yourshop.pk
# For a test on one PC (and set HTTP_PORT=8085):
#   WEB_HOST=http://web.localhost     API_HOST=http://api.localhost
#   WEB_ORIGIN=http://web.localhost:8085  PUBLIC_API_URL=http://api.localhost:8085
WEB_HOST=
API_HOST=
WEB_ORIGIN=
PUBLIC_API_URL=

# --- only for "--profile tunnel" (Cloudflare Tunnel): the token from the Cloudflare dashboard
TUNNEL_TOKEN=

# --- optional
# HTTP_PORT=80
# HTTPS_PORT=443
# BACKUP_EVERY_HOURS=24
# BACKUP_KEEP_DAYS=14
# BACKUP_KEEP_MONTHS=12
# Folder on the server where backups are kept (default: backups/ next to the project)
# BACKUP_HOST_DIR=../backups
